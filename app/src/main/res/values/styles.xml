    <!--</style>-->

    <!--<style name="Theme.AppTheme.Styled.ActionBar.TitleTextStyle" parent="@android:style/Widget.TextView">-->
        <!--<item name="android:textSize">12sp</item>-->
    <!--</style>-->
</resources>
