<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/pif_economicstate"
    tools:context=".EconomicStateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/textViewRequestFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/Field1_EconomicState"
                android:textSize="30sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupFamilyHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButtonHeadFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field3_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonHeadMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field2_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/Field8_EconomicState"
                android:textSize="30sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupSalary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButtonSalary4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field12_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonSalary3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field11_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonSalary2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field10_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonSalary1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field9_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonSalaryNone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="0.98"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field13_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/Field14_EconomicState"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxSavingNone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field15_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxBhishi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field16_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxFund"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.15"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field17_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.05"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field18_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.15"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field20_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxRDFD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field19_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxOtherFI"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.5"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field21_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkBoxAAscheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field22_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxOtherPension"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.5"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field23_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="2"
                android:text="@string/Field24_EconomicState"
                android:textSize="30sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupRationcard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButtonYellow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field27_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonOrange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field26_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonWhite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field25_EconomicState"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="2"
                android:text="@string/Field29_EconomicState"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxRationcard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.2"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field1_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxPassbook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field2_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxAadhaarcard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field3_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxPancard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.2"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field4_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxElectioncard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field5_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxElectricBill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field7_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkBoxDrivingLicense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.2"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field6_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxBirthCertificate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field11_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxPropertyTax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field8_Documents"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
