<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/pif_family_income"
    tools:context=".FamilyIncomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scrollFamilyIncome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusableInTouchMode="true"
                android:orientation="vertical">

                <!-- Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/customborder"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/textViewRequestFocus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="कुटुंबातील उत्पन्नाचा टेबल"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- सदस्यांचे कार्ड्स code मधून आपोआप इथे येतात -->
                <LinearLayout
                    android:id="@+id/llMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- A) total of the monthly column -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="364"
                        android:background="@drawable/customborder"
                        android:gravity="center_vertical"
                        android:padding="6dp"
                        android:text="A) एकूण मासिक उत्पन्न (सर्व सभासदांच्या उत्पन्ना ची टोटल)"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextTotalMonthly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:focusable="false"
                        android:inputType="none"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- B, C, D: frequency | rupees | monthly (same column grid as the table) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="242"
                        android:background="@drawable/customborder"
                        android:gravity="center_vertical"
                        android:padding="6dp"
                        android:text="B) वार्षिक उत्पन्न (गावाकडील शेतीचे)"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="68"
                        android:background="@drawable/customborder"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Annual"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextAnnualFarm"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:inputType="number"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextEffectiveMonthly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:focusable="false"
                        android:inputType="none"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="242"
                        android:background="@drawable/customborder"
                        android:gravity="center_vertical"
                        android:padding="6dp"
                        android:text="C) घरभाडे (घर भाड्याने दिले असेल तर)"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="68"
                        android:background="@drawable/customborder"
                        android:minHeight="44dp">

                        <Spinner
                            android:id="@+id/spinnerFreqRent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/editTextRent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:inputType="number"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextRentMonthly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:focusable="false"
                        android:inputType="none"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="242"
                        android:background="@drawable/customborder"
                        android:gravity="center_vertical"
                        android:padding="6dp"
                        android:text="D) इतर उत्पन्न असल्यास (पेन्शन इ.)"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="68"
                        android:background="@drawable/customborder"
                        android:minHeight="44dp">

                        <Spinner
                            android:id="@+id/spinnerFreqOther"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/editTextOtherIncome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:inputType="number"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextOtherMonthly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:focusable="false"
                        android:inputType="none"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="364"
                        android:background="@drawable/customborder"
                        android:gravity="center_vertical"
                        android:padding="6dp"
                        android:text="कुटुंबाचे एकूण मासिक उत्पन्न"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextFamilyTotal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:focusable="false"
                        android:inputType="none"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Per capita income = family total / number of members in the table -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="364"
                        android:background="@drawable/customborder"
                        android:gravity="center_vertical"
                        android:padding="6dp"
                        android:text="दरडोई उत्पन्न"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextPerCapitaIncome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="54"
                        android:background="@drawable/customborder"
                        android:focusable="false"
                        android:inputType="none"
                        android:gravity="center"
                        android:padding="6dp"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- keyboard खाली येईल तेव्हा शेवटचे फील्ड वर scroll करता यावे म्हणून मोकळी जागा -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="350dp" />

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonPrevious"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="&lt;"
                android:textSize="20sp"
                android:maxLines="1"
                android:singleLine="true"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonCloseFamilyIncome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="Close"
                android:textSize="20sp"
                android:maxLines="1"
                android:singleLine="true"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonSaveFamilyIncome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="Save"
                android:textSize="20sp"
                android:maxLines="1"
                android:singleLine="true"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="&gt;"
                android:textSize="20sp"
                android:maxLines="1"
                android:singleLine="true"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>