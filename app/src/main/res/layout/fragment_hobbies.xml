<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/pif_hobbies"
    tools:context=".HobbiesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/textViewRequestFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/Field1_Hobbies"
                android:textSize="30sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupHobbies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButtonHobbyYes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field_Yes"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonHobbyNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field_No"
                    android:textSize="30sp"
                    android:textStyle="bold" />

            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/Field2_Hobbies"
                android:textSize="30sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/checkBoxChitchat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:gravity="right|center_vertical"
                android:layoutDirection="rtl"
                android:paddingBottom="5dp"
                android:text="@string/Field5_Hobbies"
                android:textSize="30sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/checkBoxReadingNews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:gravity="right|center_vertical"
                android:layoutDirection="rtl"
                android:paddingBottom="5dp"
                android:text="@string/Field3_Hobbies"
                android:textSize="30sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/checkBoxWatchingTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:gravity="right|center_vertical"
                android:layoutDirection="rtl"
                android:paddingBottom="5dp"
                android:text="@string/Field4_Hobbies"
                android:textSize="30sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/checkBoxOtherHobbies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:gravity="right|center_vertical"
                android:layoutDirection="rtl"
                android:paddingBottom="5dp"
                android:text="@string/Field6_Hobbies"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

