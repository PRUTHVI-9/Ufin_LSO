<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/pif_assets"
    tools:context=".AssetsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewRequestFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/Field1_Assets"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewGadgetNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="5"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxNoGadget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field5_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxTVLCD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field2_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxDVD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field3_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxPClaptop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field4_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/Field6_Assets"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewApplianceNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="5"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxNoAppliance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field30_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxCooker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field7_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxMixer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field8_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxWashingMachine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field10_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxCooler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field11_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxFridge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field9_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/Field12_Assets"
                android:textSize="30sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButtonMobile3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field15_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonMobile2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field14_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonMobile1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field13_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonMobileNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field_No"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/Field16_Assets"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxVehicleNone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.5"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field_No"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxCycle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.2"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field17_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxMotorcycle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field18_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxCar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field19_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxTempo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field20_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxAutoRiksha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field21_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingBottom="5dp">

                <CheckBox
                    android:id="@+id/checkBoxRentalCar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field22_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxRentalTempo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field23_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkBoxRentalAutoRiksha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:text="@string/Field24_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/customborder"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/Field25_Assets"
                android:textSize="30sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupCookingFuel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButtonGas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.2"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field28_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonStove"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.2"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field27_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioButtonBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:text="@string/Field26_Assets"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
