<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal" android:gravity="center_vertical">
    <!--  Fixed columns: MFI Name + Loan Type  -->
    <LinearLayout android:layout_width="280dp" android:layout_height="match_parent" android:orientation="horizontal">
        <TextView android:id="@+id/tvMfiName" android:layout_width="150dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:background="@drawable/customborder" android:textColor="@android:color/black"/>
        <TextView android:id="@+id/tvLoanType" android:layout_width="130dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:textColor="@android:color/black" android:background="@drawable/customborder"/>
    </LinearLayout>
    <!--  Scrollable remaining six columns  -->
    <HorizontalScrollView android:id="@+id/hsvLoanRow" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="false" android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:layout_width="920dp" android:layout_height="match_parent" android:orientation="horizontal">
            <TextView android:id="@+id/tvLoanStatus" android:layout_width="130dp" android:layout_height="match_parent" android:text="-" android:textSize="15sp" android:textColor="#222222" android:gravity="center" android:visibility="gone" android:background="@drawable/customborder" android:padding="5dp"/>
            <TextView android:id="@+id/tvOwnGuarantor" android:layout_width="130dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:background="@drawable/customborder" android:textColor="@android:color/black"/>
            <TextView android:id="@+id/tvLoanStartDate" android:layout_width="150dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:background="@drawable/customborder" android:textColor="@android:color/black"/>
            <TextView android:id="@+id/tvDisbursementAmount" android:layout_width="160dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:background="@drawable/customborder" android:textColor="@android:color/black"/>
            <TextView android:id="@+id/tvInstallmentAmount" android:layout_width="150dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:background="@drawable/customborder" android:textColor="@android:color/black"/>
            <TextView android:id="@+id/tvCurrentBalance" android:layout_width="150dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:background="@drawable/customborder" android:textColor="@android:color/black"/>
            <TextView android:id="@+id/tvDelinquentAmount" android:layout_width="160dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:background="@drawable/customborder" android:textColor="@android:color/black"/>
            <TextView android:id="@+id/tvWriteOffAmount" android:layout_width="150dp" android:layout_height="match_parent" android:gravity="center" android:padding="5dp" android:textSize="13sp" android:background="@drawable/customborder" android:textColor="@android:color/black"/>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>